rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Products: Public can view catalog; only authenticated admins can write/update/delete
    match /products/{productId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Stock Notifications: Customers can subscribe; only admins can view/manage
    match /stockNotifications/{notificationId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Orders: Customers can submit orders and view their order status; admins can update status
    match /orders/{orderId} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    // Default fallback deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
